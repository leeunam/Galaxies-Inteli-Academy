# Use como referencia para seu .env local; preencha chaves apenas nele.
# Restrinja a chave do YouTube a YouTube Data API v3.
# Mantenha os valores deste exemplo vazios ao versionar.
YOUTUBE_API_KEY=

# Explicador via NVIDIA NIM hospedado. Nunca envie a chave em chats.
# Modelo confirmado para teste: meta/llama-3.3-70b-instruct.
NVIDIA_API_KEY=
NVIDIA_MODEL=
